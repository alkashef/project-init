{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(python scripts/cleanup.py *)"
    ],
    "ask": [
      "Edit(/docs/spec.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(conda install *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(taskkill *)",
      "PowerShell(Stop-Process *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *-f)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker compose down *-v*)",
      "Bash(docker-compose down *-v*)",
      "Bash(docker system prune *)"
    ]
  }
}
