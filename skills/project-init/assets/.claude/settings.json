{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(python scripts/cleanup.py *)",
      "Bash(python scripts/check.py *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(python scripts/cleanup.py *)",
      "PowerShell(python scripts/check.py *)"
    ],
    "ask": [
      "Edit(/docs/spec.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/settings.json)",
      "Edit(/ruff.toml)",
      "Edit(/mypy.ini)",
      "Edit(/pytest.ini)",
      "Edit(/package.json)",
      "Edit(/tsconfig.json)",
      "Edit(/eslint.config.js)",
      "Edit(/.prettierrc.json)",
      "Edit(/.stylelintrc.json)",
      "Edit(/.githooks/**)",
      "Edit(/scripts/check.py)",
      "Edit(/scripts/run-check.sh)",
      "Bash(pip install *)",
      "Bash(npm install *)",
      "Bash(conda install *)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -r *)",
      "Bash(kill *)",
      "Bash(pkill *)",
      "Bash(taskkill *)",
      "PowerShell(pip install *)",
      "PowerShell(npm install *)",
      "PowerShell(conda install *)",
      "PowerShell(rm -rf *)",
      "PowerShell(rm -fr *)",
      "PowerShell(rm -r *)",
      "PowerShell(rm *-r*)",
      "PowerShell(del *-r*)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(kill *)",
      "PowerShell(pkill *)",
      "PowerShell(taskkill *)",
      "PowerShell(Stop-Process *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push *-f)",
      "Bash(git reset *--hard*)",
      "Bash(git clean *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(git *--no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git *core.hooksPath*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker compose down *-v*)",
      "Bash(docker-compose down *-v*)",
      "Bash(docker system prune *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push -f *)",
      "PowerShell(git push *-f)",
      "PowerShell(git reset *--hard*)",
      "PowerShell(git clean *)",
      "PowerShell(git restore *)",
      "PowerShell(git checkout -- *)",
      "PowerShell(git checkout .)",
      "PowerShell(git *--no-verify*)",
      "PowerShell(git commit -n*)",
      "PowerShell(git *core.hooksPath*)",
      "PowerShell(docker volume rm *)",
      "PowerShell(docker volume prune *)",
      "PowerShell(docker compose down *-v*)",
      "PowerShell(docker-compose down *-v*)",
      "PowerShell(docker system prune *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PROJECT_DIR}/scripts/run-check.sh\" --edited",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
