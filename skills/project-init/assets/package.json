{
  "name": "project",
  "private": true,
  "type": "module",
  "description": "Dev-only tooling for checks. The app has no runtime dependencies and no build step.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" --allow-empty-input",
    "format:check": "prettier --check \"src/**/*.{js,mjs,css,html}\" \"tests/**/*.js\" --no-error-on-unmatched-pattern",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "7.0.2"
  }
}
